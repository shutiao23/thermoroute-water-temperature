# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ipynb_checkpoints/
.venv-route-a/
.venv/

# OS / editor / local
.DS_Store
.claude/
.idea/
.vscode/

# Large, regenerable artifacts (reproduced by the scripts)
outputs/predictions/
outputs/models/
outputs/logs/
# Content-addressed Stage run caches and regenerable score/table dumps.
# Authoritative completion receipts live under outputs/models/
# (route_a_stage{09,09b,16,25}_completion.json); opening receipts live under
# outputs/confirmatory/ — neither belongs in runs/ or tables/ caches. Do not
# carve runs/tables exceptions for "receipt-like" filenames.
outputs/runs/
outputs/tables/
outputs/.stage19-probabilistic.lock
outputs/.stage16-lstm.lock
outputs/.stage25-external.lock
outputs/.stage09b-parent.lock
data/processed/

# Per-station intermediate downloads (the combined panels are committed instead)
data_usgs/n*.csv
data_usgs/site_*.csv

# Route-A acquired predictors are immutable release data, not source files.
data_usgs/confirmatory_predictors/
data_usgs/confirmatory_candidate_sites_v1.csv
data_usgs/confirmatory_candidate_sites_v1.provenance.json
data_usgs/confirmatory_site_registry_v1.csv
data_usgs/confirmatory_site_registry_v1.lock.json

# Versioned raw API bytes are archived with the data release rather than Git.
data_usgs/raw_snapshots/*
!data_usgs/raw_snapshots/README.md
!data_usgs/raw_snapshots/huc-v1/
!data_usgs/raw_snapshots/huc-v1/**

# Stray run checkpoints
*_ckpt/

# Defense-in-depth: even if a future ! exception re-tracks parts of runs/,
# mutable advisory-lock diagnostics stay ignored.
outputs/runs/**/.*.formal-run.lock
# Stage-09 member locks are execution-only and intentionally persist after the
# corresponding process exits; keep them ignored under any future runs/ carve-out.
outputs/runs/**/.stage09-control-member-locks/*.lock

# LaTeX build artifacts
*.aux
*.log
*.bbl
*.blg
*.out
*.synctex.gz

# Zenodo release archive (regenerable via scripts/make_release_archive.sh)
dist/
