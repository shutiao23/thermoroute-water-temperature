# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ipynb_checkpoints/
.venv-route-a/
.venv/

# OS / editor / local
.DS_Store
.claude/
.idea/
.vscode/

# Large, regenerable artifacts (reproduced by the scripts)
outputs/predictions/
outputs/models/
outputs/logs/
# Content-addressed Stage run caches and regenerable score/table dumps.
# Authoritative completion receipts live under outputs/models/
# (route_a_stage{09,09b,16,25}_completion.json); opening receipts live under
# outputs/confirmatory/ — neither belongs in runs/ or tables/ caches. Do not
# carve runs/tables exceptions for "receipt-like" filenames.
outputs/runs/
outputs/tables/
outputs/.stage19-probabilistic.lock
outputs/.stage16-lstm.lock
outputs/.stage25-external.lock
outputs/.stage09b-parent.lock
data/processed/

# Per-station intermediate downloads (the combined panels are committed instead)
data_usgs/n*.csv
data_usgs/site_*.csv

# Route-A acquired predictors are immutable release data, not source files.
data_usgs/confirmatory_predictors/
data_usgs/confirmatory_candidate_sites_v1.csv
data_usgs/confirmatory_candidate_sites_v1.provenance.json
data_usgs/confirmatory_site_registry_v1.csv
data_usgs/confirmatory_site_registry_v1.lock.json

# Versioned raw API bytes are archived with the data release rather than Git.
data_usgs/raw_snapshots/*
!data_usgs/raw_snapshots/README.md
!data_usgs/raw_snapshots/huc-v1/
!data_usgs/raw_snapshots/huc-v1/**

# Stray run checkpoints
*_ckpt/

# Defense-in-depth: even if a future ! exception re-tracks parts of runs/,
# mutable advisory-lock diagnostics stay ignored.
outputs/runs/**/.*.formal-run.lock
# Stage-09 member locks are execution-only and intentionally persist after the
# corresponding process exits; keep them ignored under any future runs/ carve-out.
outputs/runs/**/.stage09-control-member-locks/*.lock

# LaTeX build artifacts
*.aux
*.log
*.bbl
*.blg
*.out
*.synctex.gz

# Zenodo release archive (regenerable via scripts/make_release_archive.sh)
dist/

# Conventional holdout: the panel and raw snapshot cache are regenerable
# (the persisted tables, metrics and validation report are committed instead).
# Large regenerable prediction/intermediate parquets (regenerated by the scorer).
outputs/conventional/*.parquet
outputs/conventional/panel_2021_2023.parquet
outputs/conventional/raw_2021_2023/
paper/agu_submission/ThermoRoute_WRR.fdb_latexmk
paper/agu_submission/ThermoRoute_WRR.fls

# Final results authority: per-key prediction table regenerates from the
# gitignored conventional scorer output via scripts/final/build_results_authority.py.
outputs/final/predictions.parquet

# Withdrawn DLOG-025 information/forcing runs are retained locally for forensic
# reconstruction only. They are neither manuscript authority nor source data;
# corrected observed-lineage runs publish under new versioned destinations.
outputs/final/forcing_shards_v4/
outputs/final/forcing_regime_v4_authority/
outputs/final/forcing_regime_inference_v4/
outputs/final/information_regime_v4/
outputs/final/information_regime_inference_v4/
outputs/final/ladder_shards/
outputs/final/ladder_shards_legacy/
outputs/final/forcing_contrasts_v4.parquet
outputs/final/forcing_effects.parquet
outputs/final/forcing_effects_v4.parquet
outputs/final/forcing_summary.json
outputs/final/forcing_summary_v4.json
outputs/final/ladder_effects.parquet
outputs/final/ladder_effects_legacy.parquet
outputs/final/ladder_summary.json
outputs/final/.watch/
