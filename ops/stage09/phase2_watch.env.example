# Copy to phase2_watch.env (same directory) or export before starting the watcher.
# DO NOT default EXPECTED_STAGE09_RUN_ID to the voided bb02498a run.

# Required: bind Phase-2 promotion to this source tree digest.
# Multicore Route-A amendment v2 lineage (see protocols/route_a_numerical_policy_amendment_v2.md).
EXPECTED_SOURCE_SHA256=<NEW_SOURCE_SHA256>

# Optional: once the new content-addressed run_id is known, pin it here.
# Leave empty until Stage-09 has started under the source above.
# EXPECTED_STAGE09_RUN_ID=

# Comma-separated run_ids that must never be promoted (void / superseded).
VOID_STAGE09_RUN_IDS=bb02498a8396ea7c6110

# Stage-09b process pool (clamped to 1..8 by the watcher).
# Amendment v2: 16 members x 8 threads ≈ 128 threads, ~45Gi peak.
PHASE2_09B_WORKERS=16

# If 1: abort when Stage-09 disappears without a receipt (legacy brittle mode).
# Default 0 = keep waiting so a restarted Stage-09 / WSL relaunch can finish.
PHASE2_ABORT_ON_STAGE09_EXIT=0

# ensure_phase2_watch.sh only: set 1 to also relaunch Stage-09 after reboot.
# Keep 0 unless you intentionally want unsupervised training restart.
ENABLE_STAGE09_AUTOSTART=0
